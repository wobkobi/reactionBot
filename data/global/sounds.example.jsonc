// Voice sound bites. Copy this to sounds.json - here for every server, or into
// data/<guildId>/ for one - and run /voice enable in the server.
//
// Comments and trailing commas are fine; the bot strips them when reading.
// Every setting below is optional except the triggers themselves.
//
// Run /voice check in Discord to see what actually resolves.
{
  // A pool is just a folder under data/sounds. Put your clips in
  // data/sounds/shutup/ and write "pool": "shutup" - there is no list to keep
  // in step with the files, and adding a clip needs no edit here.
  "triggers": [
    { "words": ["swag"], "pool": "shutup" },
    { "words": ["drip"], "pool": "shutup" },

    // Several words can share one pool, and a phrase works as well as a word.
    { "words": ["air horn", "airhorn"], "pool": "airhorn", "cooldownMs": 60000 },

    // For a one-off, name the file instead of making a folder for it.
    { "words": ["bruh"], "sounds": ["bruh.ogg"] }
  ],

  // Plays a clip from a folder now and then, with nobody prompting it. Delete
  // this block to switch it off.
  "ambient": { "pool": "ambience", "minMinutes": 5, "maxMinutes": 20 },

  // Whisper invents these when it hears near-silence. Never played.
  "ignore": ["thank you", "thanks for watching", "you", "bye", "subscribe"],

  // How many people a channel needs before the bot joins it.
  "minMembers": 1,

  // Default gap between clips from the same pool. Defaults to 30 seconds, so
  // set this only to widen or narrow that; a single trigger can override it
  // with its own "cooldownMs". Each pool keeps its own gap, so a trigger that
  // fires often no longer starves the rest, and a fixed 5 second floor stops
  // any two clips running together.
  "guildCooldownMs": 30000,

  // Match mishearings automatically ("swig" for "swag"). Per-trigger override
  // with "phonetic": false when a word needs to be exact.
  "phonetic": true,

  // Echo what the bot heard at debug level, for working out why a trigger is
  // or is not firing.
  "logTranscripts": false,

  // Turns voice on for every server without needing /autojoin on in each.
  "enabled": false,

  // Entrances: a clip played as someone arrives, and a post dropped in a text
  // channel the first time the bot hears them speak. Both fire at most once a
  // day per person, counted separately, and both are silenced by calm mode.
  //
  // The bot has to be in the call either way - it neither hears nor plays
  // anything in a channel it is not in. A join into an empty channel is what
  // brings it there, and the clip is held for up to 30 seconds and played once
  // the connection is ready.
  "entrances": {
    // Where the posts go. Right-click the channel > Copy Channel ID, which
    // needs Developer Mode on. Without this, only the clip half works.
    "channelId": "000000000000000000",

    "list": [
      {
        // Right-click a member > Copy User ID. Several IDs here share the one
        // entrance, which is how a group gets a single one between them.
        "users": ["000000000000000000"],

        // Plays a clip from data/sounds/woody/ as they join. The same pools
        // the triggers use, so a clip need not be kept twice.
        "pool": "woody",

        // A file the bot uploads, from data/entrances/ or
        // data/<guildId>/entrances/. Prefer this to a link for anything meant
        // to keep working: a cdn.discordapp.com URL is signed and stops working
        // 24 hours after it was issued.
        "file": "woody.mp4"
      },

      {
        // Text on its own is fine. A link alone embeds, so a GIF needs no extra
        // syntax, and mentions never ping.
        "users": ["000000000000000001", "000000000000000002"],
        "message": "look who finally turned up"
      }

      // An entry with no "pool", "file" or "message" is skipped, so an entrance
      // can be switched off without losing who it was for.
    ]
  }
}
