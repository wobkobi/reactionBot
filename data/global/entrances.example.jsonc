// Entrance posts: a message dropped in a text channel the first time the bot
// hears someone speak in voice each day.
//
// Copy to entrances.json - here for every server, or into data/<guildId>/ for
// one.
//
// The bot only hears people in the channel it is sitting in, so an entrance
// needs the bot already in the call. With `/autojoin on` it will be there as
// soon as somebody is; otherwise someone has to run `/join` first. Speech is
// what fires it, not the join itself, so sitting in a channel silently never
// triggers one.
//
// Once per person per calendar day, on the machine's local clock. Entrances
// are silenced during calm mode along with every other reply.
{
  // Where the entrances get posted. Right-click the channel > Copy Channel ID
  // (Discord needs Developer Mode on for that to appear). Nothing is posted
  // without this, and nothing is posted if the bot cannot see or write there.
  "channelId": "000000000000000000",

  "entrances": [
    {
      // Right-click a member > Copy User ID. Several IDs here share the one
      // message, which is how a group gets a single entrance between them.
      "users": ["000000000000000000"],

      // A link on its own embeds, so a video or GIF needs no extra syntax.
      // Any other text is posted as written. Mentions never ping.
      "message": "https://tenor.com/view/woody-entrance-gif"
    },

    {
      "users": ["000000000000000001", "000000000000000002"],
      "message": "look who finally turned up"
    }

    // An entry with an empty "message" is skipped, so an entrance can be
    // switched off for a while without losing who it was for.
  ]
}
