{
  "name": "reactionbot",
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('build',{recursive:true,force:true,maxRetries:10,retryDelay:200});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,md,json,yml,yaml}\"",
    "lint": "eslint \"{src,scripts}/**/*.{js,ts}\" --fix",
    "prepare": "simple-git-hooks",
    "smoke": "tsx scripts/smoke-test.ts",
    "start": "npm run build && node build/index.js",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "npm install --package-lock-only && git add package-lock.json package.json && npx lint-staged && npm run typecheck",
    "pre-push": "npm run lint && npm run build && npm run smoke -- --skip-build"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "double-metaphone": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "simple-git-hooks": "^2.14.0",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "mediaplex": "^1.0.0",
    "opusscript": "^0.1.1"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "onnxruntime-node": true,
    "simple-git-hooks": true
  }
}
