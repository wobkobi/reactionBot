# Required
BOT_TOKEN=your-bot-token
CLIENT_ID=your-application-client-id

# Optional: bot-owner ID that always passes the admin check (settings, nukes)
# in every guild. Leave blank to rely on guild owner / Manage Server only.
YOUR_ID=

# Optional: restrict the bot to one server while developing (ignore all
# others). Only honoured under `npm run dev` - production runs ignore it.
DEV_GUILD_ID=

# Optional: voice sound bites. The model downloads on first use into
# data/models. whisper-tiny.en is roughly twice as fast as the default
# whisper-base.en and a bit less accurate.
VOICE_MODEL=
VOICE_MODEL_DIR=

# Optional: ffmpeg, used once per clip to convert anything that is not already
# Ogg Opus. Ogg/Opus clips need no ffmpeg at all. Blank means "find it on PATH".
FFMPEG_PATH=

# Optional logging (defaults: info level, pretty format, colour on TTY)
# LOG_LEVEL=debug|info|warn|error
# LOG_FORMAT=pretty|json
# NO_COLOR=1
LOG_LEVEL=
LOG_FORMAT=
NO_COLOR=
